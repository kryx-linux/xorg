name=xorg-glamor-egl
version=git
release=1
source=()

build() {
	git clone git://anongit.freedesktop.org/git/xorg/driver/glamor
	cd $name
	./autogen.sh
	./configure --prefix=/usr --disable-selective-werror --enable-glx-tls
	make
	make DESTDIR=$PKG install
}
