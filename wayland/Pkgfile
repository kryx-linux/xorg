# Description: A computer display server protocol
# URL: http://wayland.freedesktop.org
# Maintainer: CRUX Xorg Team, xorg-ports at crux dot nu
# Depends on: expat libffi

name=wayland
version=1.6.0
release=1
source=(http://wayland.freedesktop.org/releases/wayland-$version.tar.xz)

build() {
	cd $name-$version

	./configure \
		--prefix=/usr \
		--mandir=/usr/man \
		--disable-documentation

	make
	make -j1 DESTDIR=$PKG PREFIX=/usr install
}
