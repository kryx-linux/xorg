# Description: xorg font font-daewoo-misc
# URL: https://xorg.freedesktop.org
# Maintainer: CRUX Xorg Team, xorg-ports at crux dot nu
# Depends on: xorg-bdftopcf xorg-font-util xorg-mkfontscale

name=xorg-font-daewoo-misc
version=1.0.4
release=1
source=(https://www.x.org/releases/individual/font/font-daewoo-misc-$version.tar.xz)

build() {
    cd font-daewoo-misc-$version

    ./configure --prefix=/usr

    make
    make DESTDIR=$PKG install

    rm $PKG/usr/share/fonts/X11/misc/fonts.dir
}
