# Description: X Window System server
# URL: http://xorg.freedesktop.org
# Maintainer: CRUX Xorg Team, xorg-ports at crux dot nu
# Depends on: mesa3d xorg-bdftopcf xorg-bigreqsproto xorg-libdmx xorg-libpixman xorg-libxaw xorg-libxcomposite xorg-libxcursor xorg-libxft xorg-libxinerama xorg-libxkbfile xorg-libxrandr xorg-libxres xorg-libxtst xorg-libxvmc xorg-libxxf86dga xorg-mkfontdir xorg-mkfontscale xorg-scrnsaverproto xorg-xcmiscproto xorg-xf86driproto

name=xorg-server
version=1.12.4
release=1
source=(http://xorg.freedesktop.org/releases/individual/xserver/$name-$version.tar.bz2)

build() {
	cd $name-$version

	./configure --prefix=/usr --enable-dri \
	            --localstatedir=/var --mandir=/usr/man \
	            --with-xkb-output=/var/lib/xkb \
	            --with-fontrootdir=/usr/share/fonts/X11 \
	            --with-sha1=libcrypto \
	            --disable-config-dbus

	make
	make DESTDIR=$PKG install

	rmdir $PKG/var/log

	install -m 755 -d $PKG/etc/X11/xorg.conf.d
}
