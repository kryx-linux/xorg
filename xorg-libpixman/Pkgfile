# Description: Pixel manipulation library
# URL: https://xorg.freedesktop.org/wiki/
# Maintainer: CRUX Xorg Team, xorg-ports at crux dot nu
# Optional: libpng

name=xorg-libpixman
version=0.46.4
release=1
source=(https://www.x.org/releases/individual/lib/pixman-$version.tar.xz)

build() {
    prt-get isinst libpng && PKGMK_PIXMAN+=' -D libpng=enabled'

    meson setup pixman-$version build $PKGMK_PIXMAN \
        --prefix=/usr \
        --buildtype=plain \
        --wrap-mode nodownload \
        -D b_lto=true \
        -D b_pie=true \
        -D tests=disabled \
        -D demos=disabled \
        -D gnu-inline-asm=enabled \
        -D rvv=disabled \
        -D openmp=disabled \
        -D gtk=disabled
    meson compile -C build -j ${JOBS:-1}
    DESTDIR=$PKG meson install -C build
}
