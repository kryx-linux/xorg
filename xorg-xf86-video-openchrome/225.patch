+static inline void
+viaDVP0SetAdjustment(ScrnInfoPtr pScrn, CARD8 adjustment)
+{
+    /* 3X5.96[3:0] - DVP0 Adjustment */
+    ViaCrtcMask(VGAHWPTR(pScrn), 0x96,
+                adjustment, BIT(3) | BIT(2) | BIT(1) | BIT(0));
+    DEBUG(xf86DrvMsg(pScrn->scrnIndex, X_INFO,
