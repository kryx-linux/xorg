# Description: xorg driver xf86-video-openchrome
# URL: http://www.freedesktop.org/wiki/Openchrome/
# Maintainer: CRUX Xorg Team, xorg-ports at crux dot nu
# Depends on: xorg-server

name=xorg-xf86-video-openchrome
version=0.6.225
release=1
source=(https://xorg.freedesktop.org/archive/individual/driver/xf86-video-openchrome-0.6.0.tar.bz2
  225.patch)

build() {
	cd xf86-video-openchrome-0.6.0

    patch -Np1 -i $SRC/225.patch

    autoreconf -fvi
	./configure --prefix=/usr

	make
	make DESTDIR=$PKG install
}
